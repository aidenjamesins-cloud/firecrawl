# Copy to your host's environment settings (Vercel: Project > Settings > Environment Variables).
# Never commit real values. The browser never sees these.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SERVER_PREFIX=us6
# true (default): new subscribers get a confirmation email first (double opt-in). Recommended.
MAILCHIMP_DOUBLE_OPT_IN=true
# Where quote requests go (phone, business details, consent record). Zapier/Make webhook, CRM, etc.
LEAD_WEBHOOK_URL=
