# Copy to .env and fill in. Never commit the real .env.
FIRECRAWL_API_KEY=
MAILCHIMP_API_KEY=            # ends in -usXX; the suffix is your data center
MAILCHIMP_AUDIENCE_ID=        # existing audience (list) id
MAILCHIMP_SERVER_PREFIX=      # e.g. us21; needed when the key is a network secret, not an env var
MAILCHIMP_FROM_NAME="Ana | James Insurance Advisory"
MAILCHIMP_REPLY_TO="[REPLY-TO ADDRESS ON YOUR DOMAIN]"

# Compliance scrub sources. With none configured, every prospect is excluded.
# Outside scrub: the records that came back clear of BOTH DNC and litigator lists.
SCRUB_CLEARED_CSV_PATH=data/scrub_cleared.csv
DNC_CSV_PATH=                 # phone numbers from your FTC DNC subscription download
LITIGATOR_CSV_PATH=           # phones/emails from your litigator list vendor
SUPPRESSION_CSV_PATH=data/suppression.csv   # unsubscribes, bounces, do-not-contact
SCRUB_API_URL=                # optional vendor API (POST {phone,email} -> {dnc,litigator})
SCRUB_API_KEY=
# Fail closed: drop prospects with no phone, since they cannot be checked against DNC.
REQUIRE_PHONE_FOR_DNC_CHECK=true

# Placeholders until supplied
AGENCY_NAME="James Insurance Advisory"
AGENCY_ADDRESS="[PHYSICAL MAILING ADDRESS]"
AGENT_LICENSE_LINE="[AGENT NAME], licensed in [STATES], License # [NUMBER]"
LICENSED_STATES=              # comma-separated two-letter codes, e.g. TX,FL
BROCHURE_URL="[BROCHURE PDF LINK]"
BOOKING_URL="[CALENDAR LINK]"
# Show flyer premiums in emails. Off until you confirm the rates apply to every recipient.
INCLUDE_PREMIUMS=false
